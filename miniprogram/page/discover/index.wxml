<view class="page" data-weui-theme="light" style="width: 100%; overflow-x: hidden;">
  <view class="container">
    <!-- 搜索和筛选区域 -->
    <view class="filter-section" catchtap="onFilterSectionTap">
      <view class="search-row">
        <view class="search-box">
          <input 
            class="search-input"
            placeholder="搜索文章..."
            value="{{searchKeyword}}"
            bindinput="onSearchInput"
          />
          <text class="search-icon">🔍</text>
        </view>
        <view 
          class="my-posts-btn {{showMyPosts ? 'active' : ''}}"
          bindtap="toggleMyPosts"
        >
          <text class="my-posts-icon">{{showMyPosts ? '✓' : ''}}</text>
          <text class="my-posts-text">我的发布</text>
        </view>
      </view>
      <view wx:if="{{showCategories && categories && categories.length > 0}}" class="category-tags-container category-tags-fade-in">
        <view class="category-tags">
          <block wx:if="{{categories}}">
            <view 
              wx:for="{{categories}}" 
              wx:key="*this"
              class="category-tag {{selectedCategory === (item === '全部' ? '' : item) ? 'active' : ''}}"
              bindtap="selectCategory"
              data-category="{{item}}"
            >
              {{item}}
            </view>
          </block>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view wx:if="{{loading}}" class="loading-container">
      <view class="loading-animation">
        <view class="loading-dot loading-dot-1">✨</view>
        <view class="loading-dot loading-dot-2">🌟</view>
        <view class="loading-dot loading-dot-3">💫</view>
      </view>
      <text class="loading-text">正在加载精彩内容...</text>
    </view>

    <!-- 错误状态 -->
    <view wx:elif="{{error}}" class="error-container">
      <text class="error-text">{{errorMessage || '获取数据失败，请稍后重试'}}</text>
      <button class="retry-btn" bindtap="retry">重试</button>
    </view>

    <!-- 瀑布流列表 -->
    <block wx:else>
      <view wx:if="{{!filteredItems || filteredItems.length === 0}}" class="empty-container">
        <text class="empty-text">暂无文章</text>
        <view class="empty-action">
          <button class="create-btn" bindtap="createArticle">创建第一篇文章</button>
        </view>
      </view>
      <view wx:elif="{{filteredItems && filteredItems.length > 0}}" class="waterfall-container">
        <view class="waterfall-column">
          <block wx:if="{{filteredItems}}">
            <view 
              wx:for="{{filteredItems}}" 
              wx:key="id"
              wx:for-item="item"
              wx:for-index="index"
              wx:if="{{index % 2 === 0}}"
              class="waterfall-item"
              bindtap="viewDetail"
              data-item="{{item}}"
            >
            <view class="item-image-wrapper">
              <image 
                class="item-image" 
                src="{{item.image}}" 
                mode="aspectFill"
                binderror="onImageError"
              ></image>
              <view wx:if="{{!item.published}}" class="draft-badge">草稿</view>
            </view>
            <view class="item-content">
              <view class="item-title">{{item.name}}</view>
              <view wx:if="{{item.description}}" class="item-description">{{item.description}}</view>
              <view wx:if="{{item.category}}" class="item-category">{{item.category}}</view>
              <!-- 浏览量和发布者信息（紧凑显示） -->
              <view wx:if="{{item.formattedViews || item.authorInfo}}" class="item-meta-compact">
                <view wx:if="{{item.formattedViews}}" class="meta-views-compact">
                  <text class="meta-icon">👁️</text>
                  <text class="meta-text">{{item.formattedViews}}</text>
                </view>
                <view wx:if="{{item.authorInfo && item.authorInfo.nickname}}" class="meta-author-compact">
                  <text class="meta-icon">👤</text>
                  <text class="meta-text">{{item.authorInfo.nickname}}</text>
                </view>
              </view>
              <view class="item-footer">
                <view class="item-dates">
                  <text wx:if="{{item.updatedAt}}" class="item-date item-date-updated">{{item.updatedAt}}</text>
                  <text wx:if="{{!item.updatedAt && !item.createdAt}}" class="item-date">{{item.displayTime}}</text>
                </view>
                <view class="item-actions">
                  <view wx:if="{{item.canEdit}}" class="action-btn edit-btn" catchtap="editArticle" data-item="{{item}}">
                    <text>✏️</text>
                  </view>
                  <view wx:if="{{item.canDelete}}" class="action-btn delete-btn" catchtap="deleteArticle" data-item="{{item}}">
                    <text>🗑️</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
          </block>
        </view>
        <view class="waterfall-column">
          <block wx:if="{{filteredItems}}">
            <view 
              wx:for="{{filteredItems}}" 
              wx:key="id"
              wx:for-item="item"
              wx:for-index="index"
              wx:if="{{index % 2 === 1}}"
              class="waterfall-item"
              bindtap="viewDetail"
              data-item="{{item}}"
            >
            <view class="item-image-wrapper">
              <image 
                class="item-image" 
                src="{{item.image}}" 
                mode="aspectFill"
                binderror="onImageError"
              ></image>
              <view wx:if="{{!item.published}}" class="draft-badge">草稿</view>
            </view>
            <view class="item-content">
              <view class="item-title">{{item.name}}</view>
              <view wx:if="{{item.description}}" class="item-description">{{item.description}}</view>
              <view wx:if="{{item.category}}" class="item-category">{{item.category}}</view>
              <!-- 浏览量和发布者信息（紧凑显示） -->
              <view wx:if="{{item.formattedViews || item.authorInfo}}" class="item-meta-compact">
                <view wx:if="{{item.formattedViews}}" class="meta-views-compact">
                  <text class="meta-icon">👁️</text>
                  <text class="meta-text">{{item.formattedViews}}</text>
                </view>
                <view wx:if="{{item.authorInfo && item.authorInfo.nickname}}" class="meta-author-compact">
                  <text class="meta-icon">👤</text>
                  <text class="meta-text">{{item.authorInfo.nickname}}</text>
                </view>
              </view>
              <view class="item-footer">
                <view class="item-dates">
                  <text wx:if="{{item.updatedAt}}" class="item-date item-date-updated">{{item.updatedAt}}</text>
                  <text wx:if="{{!item.updatedAt && !item.createdAt}}" class="item-date">{{item.displayTime}}</text>
                </view>
                <view class="item-actions">
                  <view wx:if="{{item.canEdit}}" class="action-btn edit-btn" catchtap="editArticle" data-item="{{item}}">
                    <text>✏️</text>
                  </view>
                  <view wx:if="{{item.canDelete}}" class="action-btn delete-btn" catchtap="deleteArticle" data-item="{{item}}">
                    <text>🗑️</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
          </block>
        </view>
      </view>
      <!-- 加载更多按钮 -->
      <view wx:if="{{hasMore && !loadingMore && !preloading && !loading}}" class="load-more-container">
        <text class="load-more-btn" bindtap="loadMore">加载更多</text>
      </view>
      <!-- 加载中提示 -->
      <view wx:if="{{loadingMore || preloading}}" class="loading-more">
        <text class="loading-text">加载中...</text>
      </view>
      <!-- 没有更多提示 -->
      <view wx:if="{{!hasMore && items && items.length > 0}}" class="no-more">
        <text class="no-more-text">没有更多数据了</text>
      </view>
    </block>

    <!-- 浮动新建按钮（仅登录且有读写权限后显示） -->
    <view wx:if="{{isLoggedIn && hasWritePermission}}" class="floating-add-btn" bindtap="createArticle">
      <text class="floating-add-icon">➕</text>
    </view>
  </view>
</view>

